{
  "name": "Public space reports",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "25", "jdkDistro": "tem" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [18640, 18440],
  "portsAttributes": {
    "18640": { "label": "Application", "onAutoForward": "notify" },
    "18440": { "label": "Swagger", "onAutoForward": "silent" }
  },
  "secrets": {
    "GPR_TOKEN": { "description": "Classic GitHub token with read:packages only, for the Helex libraries" }
  }
}
